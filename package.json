{
  "name": "nodus-imago",
  "version": "0.1.0",
  "description": "Local visual research databases. Research through images.",
  "author": "Jorge Pérez Burgueño",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/jorgepb96/nodus-imago.git"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && vite build && node scripts/build-electron.mjs",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "test": "node scripts/test.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "dist": "npm run build && electron-builder --config build/electron-builder.cjs",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --config build/electron-builder.cjs",
    "dist:win": "npm run build && electron-builder --win --config build/electron-builder.cjs",
    "dist:linux": "npm run build && electron-builder --linux --config build/electron-builder.cjs",
    "postinstall": "electron-builder install-app-deps",
    "licenses": "node scripts/generate-licenses.mjs",
    "icons": "node scripts/icons.mjs",
    "prebuild": "npm run licenses && npm run icons",
    "lint": "eslint .",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "dist:mac:x64": "npm run build && node scripts/package-mac-x64.mjs"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "archiver": "^8.0.0",
    "better-sqlite3": "github:WiseLibs/better-sqlite3#v12.12.0",
    "bmp-js": "^0.1.0",
    "exifr": "^7.1.3",
    "heic-decode": "^2.1.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5",
    "tar": "^7.5.22",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/adm-zip": "^0.5.7",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/bmp-js": "^0.1.2",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.6.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright-core": "^1.61.1",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=22.12"
  }
}
