{
  "name": "nodus-imago",
  "desktopName": "app.nodus.imago.desktop",
  "version": "0.1.0",
  "description": "Local visual research databases. Research through images.",
  "author": "Jorge Pérez Burgueño",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/jorgepb96/nodus-imago.git"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && vite build && node scripts/build-electron.mjs",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "test": "node scripts/test.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:audit": "node scripts/audit-e2e.mjs",
    "test:ai:e2e": "node scripts/ai-e2e.mjs",
    "test:places:e2e": "node scripts/places-e2e.mjs",
    "test:map:e2e": "node scripts/map-e2e.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "dist": "npm run build && electron-builder --config build/electron-builder.cjs",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --config build/electron-builder.cjs",
    "dist:win": "npm run build && electron-builder --win --config build/electron-builder.cjs",
    "dist:linux": "npm run build && electron-builder --linux --config build/electron-builder.cjs",
    "postinstall": "node scripts/install-native.mjs",
    "licenses": "node scripts/generate-licenses.mjs",
    "icons": "node scripts/icons.mjs",
    "prebuild": "npm run licenses && npm run icons",
    "lint": "eslint .",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "dist:mac:x64": "npm run build && node scripts/package-mac-x64.mjs",
    "test:criteria:e2e": "node scripts/criteria-e2e.mjs",
    "test:agreement:e2e": "node scripts/agreement-e2e.mjs",
    "test:agreement:reference": "node scripts/agreement-reference.mjs",
    "test:desktop:all": "node scripts/ci-e2e.mjs",
    "test:onnx:parity": "node scripts/run-electron-script.mjs scripts/onnx-parity.ts",
    "test:onboarding:e2e": "node scripts/onboarding-e2e.mjs",
    "test:native-ai:e2e": "node scripts/native-ai-e2e.mjs",
    "benchmark:research": "node scripts/run-electron-script.mjs scripts/research-benchmark.ts",
    "test:disk:e2e": "node scripts/disk-preflight-e2e.mjs",
    "test:network:e2e": "node scripts/network-preflight-e2e.mjs",
    "test:backups:e2e": "node scripts/backups-e2e.mjs",
    "test:updates:e2e": "node scripts/update-protocol-e2e.mjs"
  },
  "dependencies": {
    "@nodus/embeddinggemma-transformers": "npm:@huggingface/transformers@4.3.1",
    "@tiptap/extension-image": "3.33.1",
    "@tiptap/extension-table": "3.33.1",
    "@tiptap/extension-task-item": "3.33.1",
    "@tiptap/extension-task-list": "3.33.1",
    "@tiptap/markdown": "3.33.1",
    "@tiptap/pm": "3.33.1",
    "@tiptap/react": "3.33.1",
    "@tiptap/starter-kit": "3.33.1",
    "adm-zip": "^0.6.0",
    "archiver": "^8.0.0",
    "better-sqlite3": "github:WiseLibs/better-sqlite3#v12.12.0",
    "bmp-js": "^0.1.0",
    "electron-updater": "^6.8.9",
    "exifr": "^7.1.3",
    "exifreader": "^4.54.0",
    "heic-decode": "^2.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "marked": "18.2.0",
    "onnxruntime-node": "1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "semver": "^7.8.5",
    "sharp": "^0.35.5",
    "tar": "^7.5.22",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/adm-zip": "^0.5.7",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/bmp-js": "^0.1.2",
    "@types/js-yaml": "^4.0.9",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/semver": "^7.8.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.6.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "js-yaml": "^4.3.2",
    "playwright-core": "^1.61.1",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.8",
    "readdir-glob": {
      "minimatch": "11.0.8"
    }
  }
}
